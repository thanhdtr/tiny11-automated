# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.env

# ISOs and Images (Large Files)
*.iso
*.wim
*.esd
*.vhd
*.vhdx
*.swm

# Build Artifacts & Logs
Tiny11*/
# Per-builder staging directories (scratch copy of the source image + mounted
# output). *.iso/*.wim already cover the big files, but bootmgr, *.efi, *.cab,
# *.man and *.dll inside them are not matched by any rule above, so the whole
# staging tree has to be excluded explicitly or every build leaves ~1000
# untracked files behind.
scripts/tiny11/
scripts/nano11/
scripts/ultra11/
# Mounted-image scratch space - only exists mid-build
scripts/scratchdir/
Win11_Source.iso
scripts/tiny11-core.iso
scripts/tiny11.iso
scripts/nano11.iso
*.log
*.tmp

# Checksums and Verification Files (generated artifacts)
*.sha256
*.md5
# Per-build metadata written by the builders next to the staging tree
scripts/*-buildinfo.json
# Ignore all txt files except requirements.txt
*.txt
!requirements.txt

# OS Generated
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.swp
